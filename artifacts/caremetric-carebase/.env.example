# Local dev: copy to .env in this directory and fill in your Supabase
# project's URL and anon/publishable key (Supabase dashboard -> Project
# Settings -> API). See ../../DEPLOYMENT.md for production setup on Railway.
#
# This example contains public browser settings only. Server credentials belong in
# Railway server variables or a separate gitignored server environment file; never
# prefix a server credential with VITE_ or import it into browser code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# Optional build-time pin for the first-party CareMetric Support Hub. When unset, the app uses
# this same live URL. Any configured localhost, relative URL, credentials, path, query, fragment,
# or different origin fails closed. The link also remains hidden until the default-off
# support.central_hub release flag is intentionally enabled.
# VITE_CENTRAL_SUPPORT_HUB_URL=https://support-hub-web-production.up.railway.app

# Optional production telemetry controls. Client reports are PHI-scrubbed and sent to the
# report-client-error Supabase Edge Function; production reporting defaults to enabled.
# VITE_CLIENT_ERROR_REPORTING_ENABLED=true
# VITE_RELEASE_ID=git-commit-sha

# Set railway only after the Railway provider runtime has all required server settings.
# Unset or supabase retains the existing runtime for local/rolling compatibility.
# VITE_PROVIDER_RUNTIME=railway
# SMS MFA is offered automatically when its selected server runtime is configured.
# No VITE_MFA_SMS_ENABLED flag or Supabase Advanced MFA Phone add-on is required.
# Configure server-only TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and
# TWILIO_VERIFY_SERVICE_SID on that runtime (Railway server variables in railway mode).

# Optional. Leave unset unless this environment intentionally exposes demo login buttons.
# NEVER set VITE_DEMO_ACCOUNTS_JSON in customer production builds. Public demo hosts must set
# VITE_ENABLE_PUBLIC_DEMO=true AND use unique non-seed passwords (demo123 is stripped by the parser).
# VITE_ENABLE_PUBLIC_DEMO=true
# VITE_DEMO_ACCOUNTS_JSON='[{"label":"Org Admin","email":"admin@example.com","password":"...","color":"bg-blue-500"}]'

# Optional, build-time only, needed only when serving from a non-root subpath (see
# vite.config.ts). Leave unset for a normal deployment.
# BASE_PATH=/

# Marketing videos (AI-avatar presenters generated with HeyGen — see
# scripts/heygen/generate-landing-video.mjs and docs/marketing/landing-video-script.md)
# ship as committed assets under public/marketing and are referenced by
# src/components/marketing/marketingVideos.ts. There is no env var to set — they
# serve from the app's own origin. To move them to a CDN later, change the URLs
# in marketingVideos.ts.

# Optional. Base URL of the shared voice gateway (artifacts/voice-gateway). When unset the
# voice assistant UI is hidden entirely; when set, the Voice tab appears on the Regulatory
# Copilot page for grounded-copilot roles. Browser-safe (it is just a URL — auth uses the
# caller's Supabase JWT).
# VITE_VOICE_GATEWAY_URL=https://your-voice-gateway.up.railway.app
